        },
        "pxe_server": {
          "type": "string",
          "description": "TFTP/HTTP server for PXE boot. Required if pxe_enabled is true."
        },
        "pxe_filename": {
          "type": "string",
          "description": "PXE boot filename (e.g. ipxe.efi). Required if pxe_enabled is true."
