[
  {
    "name": "ipam.create_ip_address",
    "description": "Allocate an IP address within MOJO IPAM.",
    "inputSchema": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "description": "IP address in CIDR notation (e.g. 10.0.0.5/24) or plain (e.g. 10.0.0.5)."
        },
        "vrf_id": {
          "type": "string",
          "format": "uuid",
          "description": "VRF this address belongs to."
        },
        "status": {
          "type": "string",
          "description": "Allocation status: active, reserved, deprecated, dhcp. Defaults to active."
        },
        "dns_name": {
          "type": "string",
          "description": "FQDN for automatic forward/reverse DNS registration."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description."
        }
      }
    }
  },
  {
